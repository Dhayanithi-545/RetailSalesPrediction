# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# ── Virtual Environment ──────────────────────────────────────────────────────
venv/
.venv/
env/

# ── MLflow Artifacts ─────────────────────────────────────────────────────────
mlruns/

# ── Trained Models (too large for Git, regenerated by training) ──────────────
*.pkl
*.joblib

# ── Data Files (regenerated by scripts) ──────────────────────────────────────
data/raw/*.csv
data/processed/*.csv

# ── Metrics (generated per training run) ─────────────────────────────────────
metrics/latest_metrics.json
metrics/monitoring_*.json

# ── Pytest ───────────────────────────────────────────────────────────────────
.pytest_cache/

# ── Apache Airflow (local setup) ─────────────────────────────────────────────
airflow_home/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment Variables ────────────────────────────────────────────────────
.env

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
